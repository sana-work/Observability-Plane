# ---- Kafka ----
OBS_ENRICH_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
OBS_ENRICH_KAFKA_SECURITY_PROTOCOL=PLAINTEXT   # SASL_SSL in prod
#OBS_ENRICH_KAFKA_SASL_MECHANISM=SCRAM-SHA-512
#OBS_ENRICH_KAFKA_SASL_USERNAME=
#OBS_ENRICH_KAFKA_SASL_PASSWORD=
OBS_ENRICH_CONSUMER_GROUP=obs-enrichment
OBS_ENRICH_BATCH_MAX_MESSAGES=200

# ---- Postgres control plane ----
OBS_ENRICH_PG_DSN=postgresql://postgres:obs@localhost:5432/postgres
OBS_ENRICH_REGISTRY_CACHE_TTL_S=300

# ---- PII redaction ----
OBS_ENRICH_GLINER_ENABLED=false                # true in prod (model in image, ~512Mi)
OBS_ENRICH_GLINER_MODEL=urchade/gliner_multi_pii-v1

# ---- S3 archive ----
OBS_ENRICH_S3_ENABLED=true
OBS_ENRICH_S3_BUCKET=ai-obs-archive-dev
OBS_ENRICH_ARCHIVE_THRESHOLD_BYTES=2048

# ---- SLO + quality ----
OBS_ENRICH_SLO_ENABLED=true
OBS_ENRICH_QUALITY_SAMPLE_PCT=5.0

# ---- ops ----
OBS_ENRICH_METRICS_PORT=9108
OBS_ENRICH_LOG_LEVEL=INFO
